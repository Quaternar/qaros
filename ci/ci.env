# Defaults of ci/run.py in the standalone qaros repository (a repository embedding qaros uses the
# ci.env at its own root instead; --env-file picks another file).
#
# KEY=VALUE per line, # starts a comment line. A variable already set in the environment wins.
# A relative value of a key ending in _BIN, _DIR, _PATH or _FILE is relative to this file's folder.
#
# Native files: without QAROS_NATIVE_BIN, `run.py csharp|capi|rust --e2e` downloads the C API
# runtime (QAROS-CApi-*-RelWithDebInfo.zip, bin/ only) of this release with gh. It has no C API
# suite: `run.py c` then fails and `run.py capi` skips c. A dev-<branch> release is
# published by Quaternar/Quaternar's windows-release.yml running on that branch. The workflows
# override it with their `release` input or the QAROS_DEFAULT_RUNTIME_RELEASE repository variable.
QAROS_RUNTIME_RELEASE=dev-main-qaros-hub
QAROS_RUNTIME_REPOSITORY=Quaternar/Quaternar

# Set these instead to test against native files of your own (same build for all three):
# QAROS_NATIVE_BIN=       qar-streaming-c, qar-streaming-c-ext and every library they load
# QAROS_C_TESTS_BIN=      qar-streaming-c_dynamic_gtests (local build only; `run.py c` needs it)
# QAROS_HUB_TEST_EXT_BIN= qar-hub-test-ext (optional: the C# hub follow tests skip without it)

# The C API suite: gtest filter and the time limit of the whole run, in seconds.
QAROS_C_TEST_FILTER=*
QAROS_C_TEST_TIMEOUT=1800

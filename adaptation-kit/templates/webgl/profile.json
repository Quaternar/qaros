{
  "_sv": 3,
  "Id": "{{ID}}",
  "Name": "{{NAME}}",
  "DisplayName": "{{DISPLAY_NAME}}",
  "Version": "1.0.0",
  "Channel": "public",
  "AddressPattern": "{{ADDRESS_PATTERN}}",
  "Engine": "webgl",
  "PageRegion": {
    "Width": 1024,
    "Height": 1024
  },
  "ShareBrowserProfile": true,
  "ContinuousRendering": true,
  "AppScale": 1,
  "RenderScale": 0.75,
  "Panels": "panels",
  "Scripts": [
    {
      "Name": "capture-context",
      "Stage": "preDocument",
      "Library": "webgl-capture-context@1"
    },
    {
      "Name": "render-frame-core",
      "Stage": "afterLoad",
      "Library": "render-frame-core@1"
    },
    {
      "Name": "atlas-pack",
      "Stage": "afterLoad",
      "Library": "webgl-atlas-pack@1"
    },
    {
      "Name": "render-frame",
      "Stage": "afterLoad",
      "File": "scripts/render-frame.js"
    }
  ]
}

{
  "_sv": 3,
  "Id": "{{ID}}",
  "Name": "{{NAME}}",
  "DisplayName": "{{DISPLAY_NAME}}",
  "Version": "1.0.0",
  "Channel": "public",
  "AddressPattern": "{{ADDRESS_PATTERN}}",
  "Engine": "webgpu",
  "PageRegion": {
    "Width": 1024,
    "Height": 1024
  },
  "ShareBrowserProfile": true,
  "ContinuousRendering": false,
  "AppScale": 1,
  "RenderScale": 0.75,
  "Panels": "panels",
  "Scripts": [
    {
      "Name": "capture-context",
      "Stage": "preDocument",
      "Library": "webgpu-capture-context@1"
    },
    {
      "Name": "render-frame-core",
      "Stage": "afterLoad",
      "Library": "render-frame-core@1"
    },
    {
      "Name": "app-bridge",
      "Stage": "afterLoad",
      "File": "scripts/app-bridge.js"
    },
    {
      "Name": "render-frame-handler",
      "Stage": "afterLoad",
      "Library": "webgpu-render-frame-handler@1"
    }
  ]
}
